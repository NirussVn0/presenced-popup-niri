// presenced-popup-niri — Niri floating popup rule
// Installed by scripts/install.sh. Rust startup centers the mapped window via Niri IPC.
window-rule {
    match app-id="^presenced-popup$"
    open-floating true
    open-focused true
    default-column-width { fixed 720; }
    default-window-height { fixed 420; }
    geometry-corner-radius 18
    clip-to-geometry true
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=6
        draw-behind-window true
        color "#00000080"
    }
}
